<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId}] %-5level %logger{36} - %msg%n"/>

    <!-- Perfil dev: console + arquivo local. -->
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <!-- Grava também em ./logs/book.log para alimentar a tela de Diagnóstico
             (/diagnostico). Mesmo pattern dos perfis hom/prod, para que o leitor
             de log do backend interprete qualquer ambiente da mesma forma. -->
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/book.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>logs/book-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>7</maxHistory>
                <totalSizeCap>50MB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

        <logger name="com.tcia.book_dinamico_back_end" level="DEBUG"/>
        <logger name="org.springframework.security" level="INFO"/>
        <logger name="org.hibernate.SQL" level="INFO"/>
    </springProfile>

    <!-- Perfil hom -->
    <springProfile name="hom">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>@PATH_LOG_PRODUCAO@/book.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <!-- Nome dos arquivos de log rotacionados -->
                <fileNamePattern>@PATH_LOG_PRODUCAO@/book-%d{yyyy-MM-dd}.log</fileNamePattern>
                <!-- Tempo de retenção dos logs (opcional) -->
                <maxHistory>30</maxHistory>
                <!-- Tamanho máximo permitido para o arquivo de log (opcional) -->
                <totalSizeCap>50MB</totalSizeCap>
            </rollingPolicy>
        </appender>
        <root level="INFO">
            <appender-ref ref="FILE" />
        </root>
    </springProfile>

    <!-- Perfil prod
    ##############NAO ALTERAR O PATH DESSE BLOCO###############
    -->
    <springProfile name="prod">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>@PATH_LOG_PRODUCAO@/book.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <!-- Nome dos arquivos de log rotacionados -->
                <fileNamePattern>@PATH_LOG_PRODUCAO@/book-%d{yyyy-MM-dd}.log</fileNamePattern>
                <!-- Tempo de retenção dos logs (opcional) -->
                <maxHistory>30</maxHistory>
                <!-- Tamanho máximo permitido para o arquivo de log (opcional) -->
                <totalSizeCap>50MB</totalSizeCap>
            </rollingPolicy>
        </appender>
        <root level="INFO">
            <appender-ref ref="FILE" />
        </root>
    </springProfile>

</configuration>
