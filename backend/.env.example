# Copie este arquivo para .env e ajuste os valores.
# .env é ignorado pelo git (contém credenciais).

BOOK_AMBIENTE=DEV
BOOK_APP_NAME=book_dinamico_backend
BOOK_APP_CONTEXT_PATH=/book_dinamico
BOOK_APP_PORT=8082
BOOK_NOME_SISTEMA=Book Dinâmico
BOOK_URL_SITE=http://localhost:8082/book_dinamico
BOOK_URL_FRONT_END=http://localhost:3000
# Diretório de armazenamento dos uploads — DEVE ficar FORA do projeto
# (volume/disco externo). Nunca dentro do diretório da aplicação.
BOOK_DIRETORIO=/var/dados/book-dinamico-arquivos
BOOK_JWT_SECRET=substitua-por-string-longa-aleatoria
BOOK_DB_URL=jdbc:postgresql://localhost:5432/book_dinamico
BOOK_DB_USERNAME=book_user
BOOK_DB_PASSWORD=sua_senha
BOOK_MAIL_HOST=smtp.gmail.com
BOOK_MAIL_PORT=587
BOOK_MAIL_USERNAME=seu-email@dominio.com
BOOK_MAIL_PASSWORD=sua-app-password
